---
type SocialName = "facebook" | "tiktok";
const { name } = Astro.props as { name: SocialName };
---

{name === "facebook" && (
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M14 8h3V4h-3c-3.4 0-5 2-5 5v3H6v4h3v8h4v-8h3.2l.8-4h-4V9c0-.7.3-1 1-1Z" />
  </svg>
)}

{name === "tiktok" && (
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M16.4 3c.4 2.1 1.6 3.6 3.6 4.4v3.4a9.2 9.2 0 0 1-3.5-1.2V16a6.5 6.5 0 1 1-5.6-6.4v3.5a3.1 3.1 0 1 0 2.1 3V3h3.4Z" />
  </svg>
)}
