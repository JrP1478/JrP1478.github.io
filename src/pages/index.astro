---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import { PRODUCTS } from "../data/products";
import { SITE, whatsappLink } from "../data/site";

const title = "Trapos industriales, waipe y merma textil en Perú | Biohebra";
const description =
  "Venta de trapo industrial suelto y cosido, waipe y merma de jean. Productos por kilo para limpieza, mantenimiento y reutilización. Envíos a todo el Perú.";

const categories = [
  { title: "Trapo industrial", text: "Opciones para limpieza, mantenimiento, herramientas, piezas y superficies de trabajo.", href: "/trapo-industrial/", icon: "industrial" },
  { title: "Trapo suelto", text: "Retazos independientes para limpieza general y trabajos donde se cambia el material con frecuencia.", href: "/trapo-industrial-suelto/", icon: "suelto" },
  { title: "Trapo cosido", text: "Piezas textiles unidas para un manejo más estable durante tareas repetitivas de limpieza.", href: "/trapo-industrial-cosido/", icon: "cosido" },
  { title: "Waipe industrial", text: "Material de limpieza para mantenimiento, wipe-down de superficies y retiro de grasa o aceite.", href: "/waipe-industrial/", icon: "waipe" },
  { title: "Merma de jean", text: "Retazos de denim para clasificación, reciclaje mecánico y reaprovechamiento como materia prima.", href: "/merma-de-jean/", icon: "merma" },
];

const reasons = [
  ["01", "Material textil reutilizado", "Aprovechamos saldos y retazos textiles y les damos una nueva utilidad productiva."],
  ["02", "Precios visibles", "Consulta el precio por kilo de cada producto antes de comunicarte con nosotros."],
  ["03", "Envíos a todo el Perú", "Coordinamos el pedido y el despacho según cantidad y destino."],
  ["04", "Atención directa", "Cotiza por WhatsApp y consulta disponibilidad, cantidad y condiciones de envío."],
];

const productListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Productos Biohebra",
  itemListElement: PRODUCTS.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(
      product.slug === "merma-de-jean" ? "/merma-de-jean/" : "/" + product.slug + "/",
      SITE.domain
    ).toString(),
    name: product.name,
  })),
};
---

<BaseLayout title={title} description={description} jsonLd={productListSchema}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Biohebra · Lima, Perú</span>
        <h1>
          Trapos industriales, waipe y <strong>textiles reutilizados</strong> para tu negocio
        </h1>
        <p class="lead">
          Encuentra trapo suelto, trapo cosido, waipe y merma de jean para limpieza,
          mantenimiento y reaprovechamiento. Consulta precios por kilo y cotiza por WhatsApp.
        </p>
        <div class="hero-actions">
          <a
            class="button button-accent"
            href={whatsappLink("Hola, quiero cotizar productos Biohebra. ¿Me pueden confirmar disponibilidad, cantidades y condiciones de envío?")}
            target="_blank"
            rel="noopener noreferrer"
          >
            Cotizar por WhatsApp
          </a>
          <a class="button button-secondary" href="#productos">Ver productos</a>
        </div>
        <div class="hero-proof" aria-label="Información de compra">
          <span>Envíos a todo el Perú</span>
          <span>Precios por kilo</span>
          <span>Atención directa</span>
          <span>RUC {SITE.ruc}</span>
        </div>
      </div>

      <div class="hero-visual" aria-label="Productos Biohebra">
        <div class="hero-product-main">
          <img
            src="/img/products/trapo-industrial-cosido-color.png"
            alt="Trapo Industrial cosido - color de Biohebra"
            width="700"
            height="700"
          />
        </div>
        <div class="hero-price-card">
          <small>Trapo Industrial cosido - color</small>
          <strong>S/ 1.90 por kilo</strong>
        </div>
        <div class="hero-product-mini">
          <img
            src="/img/products/waipe-blanco.png"
            alt="Waipe - blanco de Biohebra"
            width="320"
            height="320"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="trust-bar" aria-label="Confianza Biohebra">
    <div class="container trust-grid">
      <div class="trust-item">
        <strong>Compra informada</strong>
        <span>Precios visibles por producto</span>
      </div>
      <div class="trust-item">
        <strong>Atención por WhatsApp</strong>
        <span>Consulta disponibilidad y cantidad</span>
      </div>
      <div class="trust-item">
        <strong>Cobertura nacional</strong>
        <span>Coordinamos envíos a todo el Perú</span>
      </div>
      <div class="trust-item">
        <strong>Negocio identificado</strong>
        <span>RUC {SITE.ruc}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Compra por categoría</span>
        <h2>Encuentra rápido el material que necesitas</h2>
        <p class="lead">
          Organizamos el catálogo por tipo de material y forma de uso para que puedas comparar
          trapo suelto, trapo cosido, waipe y merma de jean sin depender de un único término.
        </p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card" href={category.href}>
            <span class="category-icon"><CategoryIcon name={category.icon as "industrial" | "suelto" | "cosido" | "waipe" | "merma"} /></span>
            <div>
              <h3>{category.title}</h3>
              <p>{category.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="productos" class="section section-soft">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">Catálogo Biohebra</span>
        <h2>Productos y precios por kilo</h2>
        <p class="lead">
          Revisa las opciones disponibles y entra a la ficha de cada producto para conocer usos,
          aplicaciones y cotizar directamente.
        </p>
      </div>
      <div class="product-grid">
        {PRODUCTS.map((product, index) => <ProductCard product={product} priority={index < 2} />)}
      </div>
    </div>
  </section>

  <section id="usos" class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Compra según tu necesidad</span>
        <h2>¿Para qué necesitas el trapo o waipe?</h2>
        <p class="lead">
          Elige según la suciedad que necesitas retirar, la superficie de trabajo y la forma en
          que prefieres manipular o reemplazar el material.
        </p>
      </div>
      <div class="use-grid">
        <article class="use-card">
          <h3>Talleres mecánicos</h3>
          <p>Para retirar grasa, aceite y suciedad de herramientas, piezas, equipos y superficies de trabajo.</p>
          <a class="text-link" href="/usos/trapos-para-talleres/">Ver recomendaciones →</a>
        </article>
        <article class="use-card">
          <h3>Grasa y aceite</h3>
          <p>Compara trapo y waipe para lubricantes, grasa y residuos oleosos en piezas, maquinaria y áreas de mantenimiento.</p>
          <a class="text-link" href="/usos/trapos-para-grasa-y-aceite/">Ver opciones →</a>
        </article>
        <article class="use-card">
          <h3>Limpieza industrial</h3>
          <p>Para limpieza general, wipe-down de superficies, mantenimiento de equipos y atención de suciedad o derrames.</p>
          <a class="text-link" href="/usos/trapos-para-limpieza-industrial/">Ver guía →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">Por qué Biohebra</span>
        <h2>Información clara antes de cotizar</h2>
      </div>
      <div class="reason-grid">
        {reasons.map(([number, heading, text]) => (
          <article class="reason-card">
            <span class="reason-number">{number}</span>
            <h3>{heading}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-green">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Cómo comprar</span>
        <h2>Tres pasos para cotizar tu pedido</h2>
      </div>
      <div class="process-grid">
        <article class="process-card">
          <h3>Elige tu producto</h3>
          <p>Compara el tipo de material, el color, el precio y la presentación según la tarea que realizarás.</p>
        </article>
        <article class="process-card">
          <h3>Cotiza por WhatsApp</h3>
          <p>Indica el producto, la cantidad aproximada y tu ciudad o distrito para revisar disponibilidad.</p>
        </article>
        <article class="process-card">
          <h3>Coordinamos el envío</h3>
          <p>Confirmamos disponibilidad, condiciones del pedido y forma de entrega según el destino.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="nosotros" class="section">
    <div class="container about-grid">
      <div class="about-image">
        <img
          src="/img/svg/saldos.jpg"
          alt="Material textil reutilizado por Biohebra"
          loading="lazy"
          width="760"
          height="570"
        />
      </div>
      <div class="about-copy">
        <span class="eyebrow">Sobre Biohebra</span>
        <h2>Reutilizamos textiles para darles una nueva utilidad</h2>
        <p class="lead">
          Biohebra trabaja con saldos y retazos textiles para ofrecer productos destinados a
          limpieza, mantenimiento y reaprovechamiento.
        </p>
        <p>
          Nuestro catálogo incluye trapo industrial suelto y cosido, waipe en color y blanco,
          además de merma de jean. Atendemos consultas y coordinamos envíos a diferentes regiones
          del Perú.
        </p>
        <ul>
          <li>Catálogo con precios por kilo.</li>
          <li>Atención directa por WhatsApp.</li>
          <li>Datos de contacto, RUC y ubicación visibles.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container final-cta">
      <div>
        <h2>¿Necesitas trapo industrial, waipe o merma de jean?</h2>
        <p>
          Escríbenos indicando el producto y la cantidad que necesitas. Te confirmaremos
          disponibilidad y condiciones de envío.
        </p>
      </div>
      <a
        class="button button-accent"
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
      >
        Cotizar ahora
      </a>
    </div>
  </section>
</BaseLayout>
