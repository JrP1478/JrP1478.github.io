---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { PRODUCTS } from "../../../data/products";

const recommended = PRODUCTS.filter((p) => p.category !== "merma");
---

<BaseLayout
  title="Trapos para limpieza industrial y mantenimiento | Biohebra Perú"
  description="Trapo industrial suelto y cosido, waipe color y blanco para limpieza industrial, mantenimiento, maquinaria y superficies. Revisa precios por kilo."
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "Usos" }, { label: "Limpieza industrial" }]} />
      <div class="page-hero-copy">
        <span class="eyebrow">Mantenimiento y limpieza</span>
        <h1>Trapos para limpieza industrial</h1>
        <p class="lead">
          Biohebra ofrece distintas presentaciones de material textil para limpieza frecuente,
          mantenimiento, herramientas, piezas, superficies y maquinaria.
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="product-grid">
        {recommended.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>
</BaseLayout>
