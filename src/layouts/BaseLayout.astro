---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsappFloat from "../components/WhatsappFloat.astro";
import { SITE } from "../data/site";

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonicalPath?: string;
  pageType?: "website" | "product";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description,
  image = "/img/products/trapo-industrial-cosido-color.webp",
  imageAlt = title,
  canonicalPath = Astro.url.pathname,
  pageType = "website",
  jsonLd = [],
} = Astro.props;

const base = Astro.site ?? new URL(SITE.domain);
const homeUrl = new URL("/", base).toString();
const canonical = new URL(canonicalPath, base).toString();
const socialImage = new URL(image, base).toString();
const logoUrl = new URL("/img/svg/logo-biohebra.png", base).toString();
const organizationId = new URL("/#organization", base).toString();
const websiteId = new URL("/#website", base).toString();
const isHome = canonical === homeUrl;
const extraSchemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: SITE.name,
  alternateName: ["Biohebra Perú", "biohebra.uk"],
  url: homeUrl,
  description:
    "Biohebra comercializa trapo industrial, waipe y merma textil para limpieza, mantenimiento y reaprovechamiento, con atención en Lima y envíos a todo el Perú.",
  logo: {
    "@type": "ImageObject",
    url: logoUrl,
    contentUrl: logoUrl,
    width: 342,
    height: 396,
  },
  email: SITE.email,
  taxID: SITE.ruc,
  telephone: SITE.phoneDisplay,
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    telephone: SITE.phoneDisplay,
    email: SITE.email,
    availableLanguage: "Spanish",
    areaServed: "PE",
  },
  areaServed: {
    "@type": "Country",
    name: "Perú",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lurigancho-Chosica",
    addressRegion: "Lima",
    addressCountry: "PE",
  },
  sameAs: [SITE.facebook, SITE.tiktok],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: SITE.name,
  alternateName: ["Biohebra Perú", "biohebra.uk"],
  url: homeUrl,
  inLanguage: "es-PE",
  publisher: {
    "@id": organizationId,
  },
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#00693E" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/img/svg/logo-biohebra.png" />
    <link rel="apple-touch-icon" href="/img/icons/logo192.png" />

    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    )}
    {extraSchemas.filter(Boolean).map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsappFloat />
  </body>
</html>
