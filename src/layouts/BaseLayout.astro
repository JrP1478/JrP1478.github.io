---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsappFloat from "../components/WhatsappFloat.astro";
import { SITE } from "../data/site";

type Props = {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
  pageType?: "website" | "product";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description,
  image = "/img/products/trapo-industrial-cosido-color.png",
  canonicalPath = Astro.url.pathname,
  pageType = "website",
  jsonLd = [],
} = Astro.props;

const base = Astro.site ?? new URL(SITE.domain);
const canonical = new URL(canonicalPath, base).toString();
const socialImage = new URL(image, base).toString();
const extraSchemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.domain,
  logo: new URL("/img/svg/logo-sinfondo.png", base).toString(),
  email: SITE.email,
  taxID: SITE.ruc,
  telephone: SITE.phoneDisplay,
  areaServed: {
    "@type": "Country",
    name: "Perú",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lurigancho-Chosica",
    addressRegion: "Lima",
    addressCountry: "PE",
  },
  sameAs: [SITE.facebook, SITE.tiktok],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.domain,
  inLanguage: "es-PE",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#00693E" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/img/svg/logo-sinfondo.png" />

    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    {extraSchemas.filter(Boolean).map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsappFloat />
  </body>
</html>
